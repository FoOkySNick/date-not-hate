# Production settings for docker-compose.prod.yml. Never commit the real .env.
# Public address of this application. The DNS A record must point to the VPS.
APP_HOST=app.date-not-hate.ru
APP_URL=https://app.date-not-hate.ru
# An existing inbox for Let's Encrypt service notifications; it can be Gmail.
ACME_EMAIL=your-existing-email@example.com
POSTGRES_DB=date_not_hate
POSTGRES_USER=date_not_hate
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-a-long-random-application-secret
# Any sender address on a domain confirmed in Resend; a mailbox is not required.
MAIL_FROM=Date, not Hate <hello@mail.date-not-hate.ru>
RESEND_API_KEY=replace-with-resend-api-key
VAPID_SUBJECT=mailto:your-existing-email@example.com
VAPID_PUBLIC_KEY=generate-with-npm-run-push:keys
VAPID_PRIVATE_KEY=generate-with-npm-run-push:keys
