# Значения соответствуют docker-compose.yml. Скопируйте в .env при необходимости.
DATABASE_URL=postgres://date_not_hate:date_not_hate@localhost:5432/date_not_hate
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173
APP_HOST=localhost
# В production задайте длинную случайную строку и не храните её в git.
JWT_SECRET=change-this-local-secret-before-sharing
# Реальная отправка писем через Unisender Go HTTPS API.
# Подтвердите адрес или домен отправителя в Unisender Go и создайте API-ключ.
MAIL_FROM=Date, not Hate <your-confirmed-email@example.com>
UNISENDER_GO_API_KEY=
# Сгенерируйте ключи: npm run push:keys -w backend
VAPID_SUBJECT=mailto:your-email@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
